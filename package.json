{
    "name": "firebase-admin-edge",
    "version": "3.0.0",
    "description": "Firebase Authentication, Firestore, and Admin features for edge runtimes and serverless apps, built with TypeScript and Firebase REST APIs.",
    "keywords": [
        "firebase",
        "firebase-admin",
        "firebase-auth",
        "firestore",
        "typescript",
        "authentication",
        "oauth",
        "jwt",
        "session-cookies",
        "edge",
        "serverless",
        "cloudflare",
        "cloudflare-workers",
        "vercel-edge",
        "deno",
        "bun"
    ],
    "homepage": "https://github.com/jdgamble555/firebase-admin-edge",
    "bugs": {
        "url": "https://github.com/jdgamble555/firebase-admin-edge/issues"
    },
    "author": "Jonathan Gamble",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jdgamble555/firebase-admin-edge.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "license": "MIT",
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@types/node": "^24.10.1",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "rimraf": "^6.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.9"
    },
    "scripts": {
        "build": "npm run clean && tsc",
        "ci": "npm run build && npm run check-types && npm run check-format && npm run test",
        "check-types": "tsc --noEmit -p tsconfig.validation.json",
        "fci": "npm run format &&npm run ci",
        "format": "prettier --write .",
        "check-format": "prettier --check .",
        "test": "vitest run",
        "dev": "vitest",
        "clean": "rimraf dist",
        "local-release": "npm run format && changeset version && changeset publish",
        "prepublishOnly": "npm run ci",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:publish": "changeset publish",
        "test:integration": "vitest run --config vitest.integration.config.ts"
    },
    "dependencies": {
        "jose": "^6.1.2"
    }
}
